# Copy to deploy/.env on the EC2 instance and fill in. Do NOT commit the real .env.
# Mirrors the keys the API reads (see apps/api/.env.example) plus Caddy's TLS settings.

# ---- Caddy / TLS ----
# Public hostname for the FRONTEND. Must resolve (A record, DNS-only) to this instance's EIP.
WEB_DOMAIN=www.siambox.example
# Public hostname for the API (used when you migrate the API onto this box later).
API_DOMAIN=api.siambox.example
# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# ---- Frontend build/runtime ----
# Baked into the client bundle AND read server-side for SSR. Point at your LIVE API:
#   - during migration: the current Render API URL
#   - after the API moves here: https://api.<your-domain>
NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# ---- API runtime ----
NODE_ENV=production
API_PORT=4000
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres?sslmode=require
ADMIN_TOKEN=
# Comma-separated production web origins, e.g. https://siambox.com,https://admin.siambox.com
CORS_ORIGIN=
CNY_TO_THB_RATE=5.0

# ---- Supabase Storage ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=siambox-products

# ---- Payment gateway ----
# Which provider new checkouts go through: ksher | opn | 2c2p
# Leave unset to disable the gateway (checkout falls back to manual QR + slip).
PAYMENT_PROVIDER=ksher

# Ksher — Thai PSP focused on China cross-border. Signature is HMAC-SHA256 over the
# request params keyed by the API token; there is no bearer auth.
KSHER_APPID=
KSHER_API_TOKEN=
# Optional sub-merchant id, if Ksher issued one.
KSHER_MID=
KSHER_API_BASE=https://api.ksher.net
# Ksher signs the callback over its FULL url, so this must match the webhook URL
# configured in the Ksher dashboard exactly (no query string).
KSHER_WEBHOOK_URL=

# Opn Payments (ex-Omise) — secret key from Dashboard -> Keys. Test keys start skey_test_.
OPN_SECRET_KEY=
OPN_API_BASE=https://api.omise.co
# Opn does not sign webhooks. Append ?key=<this> to the webhook URL in the Opn
# dashboard so only Opn can reach the endpoint. Leave unset in local dev to skip.
OPN_WEBHOOK_SECRET=

# 2C2P — merchant id + secret key from the 2C2P merchant portal.
TWOCTWOP_MERCHANT_ID=
TWOCTWOP_SECRET_KEY=
# Sandbox: https://sandbox-pgw.2c2p.com  Production: https://pgw.2c2p.com
TWOCTWOP_API_BASE=https://sandbox-pgw.2c2p.com
# Sent as backendReturnUrl — 2C2P posts its JWT notification here.
TWOCTWOP_WEBHOOK_URL=

# Public web URL the gateway redirects customers back to after payment.
WEB_BASE_URL=

# ---- LINE Messaging API (optional) ----
# Push new-order notifications to a LINE group chat.
# Channel access token from LINE Developers Console → Messaging API channel.
# Group ID from the webhook join/message event (groupId field) after adding the bot.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=
