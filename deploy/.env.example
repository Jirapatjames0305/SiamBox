# Copy to deploy/.env on the EC2 instance and fill in. Do NOT commit the real .env.
# Mirrors the keys the API reads (see apps/api/.env.example) plus Caddy's TLS settings.

# ---- Caddy / TLS ----
# Public hostname for the FRONTEND. Must resolve (A record, DNS-only) to this instance's EIP.
WEB_DOMAIN=www.siambox.example
# Public hostname for the API (used when you migrate the API onto this box later).
API_DOMAIN=api.siambox.example
# Email Let's Encrypt uses for expiry notices. Also the Alibaba Cloud account owner.
ACME_EMAIL=siamboxsupport@gmail.com

# ---- Frontend build/runtime ----
# Baked into the client bundle AND read server-side for SSR. Point at your LIVE API:
#   - during migration: the current Render API URL
#   - after the API moves here: https://api.<your-domain>
NEXT_PUBLIC_API_URL=https://api.siambox.shop
# ใช้เฉพาะตอน server-side rendering ในคอนเทนเนอร์ — ยิงโดเมนสาธารณะจากในเครื่องตัวเอง
# จะ timeout (NAT hairpin) ถ้าไม่ตั้ง หน้าเว็บจะขึ้นแต่ไม่มีสินค้า
API_INTERNAL_URL=http://api:4000

# ---- API runtime ----
NODE_ENV=production
API_PORT=4000
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres?sslmode=require
ADMIN_TOKEN=
# Comma-separated production web origins, e.g. https://siambox.com,https://admin.siambox.com
CORS_ORIGIN=
CNY_TO_THB_RATE=5.0
# Display-only rates for the storefront's currency switcher (out of CNY).
CNY_TO_HKD_RATE=1.09
CNY_TO_USD_RATE=0.14

# ---- Supabase Storage ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=siambox-products

# ---- Payment gateway ----
# Which provider new checkouts go through: ksher | opn | 2c2p | antom | siampay
# Leave unset to disable the gateway (checkout falls back to manual QR + slip).
PAYMENT_PROVIDER=ksher

# Ksher — Thai PSP focused on China cross-border. Signature is HMAC-SHA256 over the
# request params keyed by the API token; there is no bearer auth.
KSHER_APPID=
KSHER_API_TOKEN=
# Optional sub-merchant id, if Ksher issued one.
KSHER_MID=
KSHER_API_BASE=https://api.ksher.net
# Ksher signs the callback over its FULL url, so this must match the webhook URL
# configured in the Ksher dashboard exactly (no query string).
KSHER_WEBHOOK_URL=

# Opn Payments (ex-Omise) — secret key from Dashboard -> Keys. Test keys start skey_test_.
OPN_SECRET_KEY=
OPN_API_BASE=https://api.omise.co
# Opn does not sign webhooks. Append ?key=<this> to the webhook URL in the Opn
# dashboard so only Opn can reach the endpoint. Leave unset in local dev to skip.
OPN_WEBHOOK_SECRET=

# 2C2P — merchant id + secret key from the 2C2P merchant portal.
TWOCTWOP_MERCHANT_ID=
TWOCTWOP_SECRET_KEY=
# Sandbox: https://sandbox-pgw.2c2p.com  Production: https://pgw.2c2p.com
TWOCTWOP_API_BASE=https://sandbox-pgw.2c2p.com
# Sent as backendReturnUrl — 2C2P posts its JWT notification here.
TWOCTWOP_WEBHOOK_URL=

# Antom (Ant International) — first-party Alipay/WeChat. Auth is RSA-SHA256, not a
# shared secret: generate a keypair, upload the PUBLIC half to the Antom portal and put
# the PRIVATE half here. Keys may be pasted as one line with \n escapes, with or
# without the PEM header.
ANTOM_CLIENT_ID=
ANTOM_PRIVATE_KEY=
# Antom's own public key, from the portal — used to verify inbound notifications.
# Unset skips verification: local dev only, never production.
ANTOM_PUBLIC_KEY=
ANTOM_API_BASE=https://open-sea-global.alipay.com
# Where Antom posts payment results: https://api.<domain>/api/webhooks/antom
ANTOM_NOTIFY_URL=
# paymentMethodType used when the customer picks no specific wallet. Default ALIPAY_CN.
ANTOM_PAYMENT_METHOD=

# SiamPay (AsiaPay Thailand) — the documented fallback. Merchant id + secure hash
# secret come from the AsiaPay merchant portal; they are all the redirect checkout needs.
SIAMPAY_MERCHANT_ID=
SIAMPAY_SECURE_HASH_SECRET=
SIAMPAY_API_BASE=https://www.siampay.com
# Separate API account, required only for order status sync and refunds. Without it
# checkout still works but the datafeed cannot confirm a payment.
SIAMPAY_LOGIN_ID=
SIAMPAY_PASSWORD=
# Hosted payment page language: E (English) | T (Thai) | C (Chinese)
SIAMPAY_LANG=E
# Set the datafeed URL to https://api.<domain>/api/webhooks/siampay in the AsiaPay
# portal and switch the datafeed ON — it is off by default.

# Public web URL the gateway redirects customers back to after payment.
WEB_BASE_URL=

# ---- LINE Messaging API (optional) ----
# Push new-order notifications to a LINE group chat.
# Channel access token from LINE Developers Console → Messaging API channel.
# Group ID from the webhook join/message event (groupId field) after adding the bot.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=
