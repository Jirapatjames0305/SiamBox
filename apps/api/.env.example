# apps/api — set these on Render → Environment.
# Locally the API loads `<repo>/.env` first; this file documents the keys
# the API itself reads.

DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres?sslmode=require

# Render injects $PORT (=10000 by default for free web services).
# Keep API_PORT aligned with what render.yaml sets.
API_PORT=4000

# Comma-separated list of allowed origins for browser requests.
# In production: https://<web>.pages.dev,https://<admin>.pages.dev
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Bearer token required by /api/admin routes
ADMIN_TOKEN=replace-with-a-long-random-string

# Supabase Storage — used for product image uploads.
# URL + service_role key from Supabase dashboard → Settings → API.
# Bucket must exist and be public (Storage → New bucket → "Public").
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=siambox-products

# Web app base — where the gateway redirects the customer back to after payment.
WEB_BASE_URL=http://localhost:3000

# ---- Payment gateway ----
# Which provider new checkouts go through: ksher | opn | 2c2p
# Leave unset to disable the gateway (checkout falls back to manual QR + slip).
PAYMENT_PROVIDER=ksher

# Ksher — Thai PSP focused on China cross-border. Signature is HMAC-SHA256 over the
# request params keyed by the API token; there is no bearer auth.
KSHER_APPID=
KSHER_API_TOKEN=
# Optional sub-merchant id, if Ksher issued one.
KSHER_MID=
KSHER_API_BASE=https://api.ksher.net
# Ksher signs the callback over its FULL url, so this must match the webhook URL
# configured in the Ksher dashboard exactly (no query string).
KSHER_WEBHOOK_URL=

# Opn Payments (ex-Omise) — secret key from Dashboard -> Keys. Test keys start skey_test_.
OPN_SECRET_KEY=
OPN_API_BASE=https://api.omise.co
# Opn does not sign webhooks. Append ?key=<this> to the webhook URL in the Opn
# dashboard so only Opn can reach the endpoint. Leave unset in local dev to skip.
OPN_WEBHOOK_SECRET=

# 2C2P — merchant id + secret key from the 2C2P merchant portal.
TWOCTWOP_MERCHANT_ID=
TWOCTWOP_SECRET_KEY=
# Sandbox: https://sandbox-pgw.2c2p.com  Production: https://pgw.2c2p.com
TWOCTWOP_API_BASE=https://sandbox-pgw.2c2p.com
# Sent as backendReturnUrl — 2C2P posts its JWT notification here.
TWOCTWOP_WEBHOOK_URL=

# All three providers settle in THB while we price in CNY — conversion rate for the charge.
CNY_TO_THB_RATE=5.0

# LINE Messaging API — push order notifications to a LINE group chat.
# 1. Create a Messaging API channel at developers.line.biz
# 2. Add the bot to your LINE group
# 3. Get LINE_GROUP_ID from the webhook join/message event (groupId field)
# Leave unset to disable LINE notifications.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=
